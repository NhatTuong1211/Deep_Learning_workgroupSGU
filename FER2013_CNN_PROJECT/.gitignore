# .gitignore – FER2013 CNN Project

# ---- Dataset lớn ----
data/raw/
data/processed/
*.csv.gz
*.zip
*.tar.gz

# ---- Checkpoints & weights (lưu ngoài repo) ----
checkpoints/*.pth
checkpoints/*.pt
# Ngoại lệ: giữ best_config.json
!checkpoints/best_config.json
!checkpoints/.gitkeep

# ---- Python cache ----
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# ---- Virtual environment ----
venv/
env/
.venv/
.env/

# ---- Jupyter ----
.ipynb_checkpoints/
*.ipynb

# ---- Logs & experiment outputs (lớn) ----
experiments/*/
!experiments/.gitkeep
!experiments/experiment_log.csv
!experiments/experiment_summary.csv

# ---- Kết quả ảnh tạm ----
#results/**/*.png
#results/**/*.jpg
#!results/.gitkeep

# ---- IDE ----
.vscode/
.idea/
*.swp
*.swo

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- API keys, secrets ----
.env
*.key
secrets.json

# ---- Build ----
dist/
build/
*.egg-info/
