{
    "dataset_url": "https://www.kaggle.com/datasets/julinmaloof/the-oxfordiiit-pet-dataset",
    "download_date": "2026-11-22",
    "archive_name": "the-oxfordiiit-pet-dataset.zip",
    "data_version": "v1.0",
    "seed": 42,
    "img_size": [
        256,
        256
    ],
    "split_ratio": {
        "train": 0.7,
        "val": 0.15,
        "test": 0.15
    },
    "stratify": "37_breeds",
    "border_policy": "merge_3_to_pet_1",
    "mean": [
        0.485,
        0.456,
        0.406
    ],
    "std": [
        0.229,
        0.224,
        0.225
    ],
    "augmentation": {
        "horizontal_flip_p": 0.5,
        "rotation_degrees": 15,
        "brightness": 0.2,
        "contrast": 0.2,
        "mask_rotate_fill": 0
    },
    "batch_size": 16,
    "num_workers": 2
}